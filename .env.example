# Copie para .env e preencha com valores reais do seu ambiente.
# .env nunca é versionado (ver .gitignore) - este arquivo é o único que é.

# --- Postgres (farol-db) ---------------------------------------------------
# Nome/usuário/senha do banco que o próprio compose sobe (postgres:16-alpine).
# FAROL_DB_DSN precisa bater com os três valores acima (mesmo host "farol-db",
# nome do serviço no compose).
FAROL_DB_NAME=farol
FAROL_DB_USER=farol
FAROL_DB_PASSWORD=troque-esta-senha
FAROL_DB_DSN=postgresql://farol:troque-esta-senha@farol-db:5432/farol

# --- Painel (técnico + gerencial) -------------------------------------------
# Credencial de login do painel técnico (form + sessão por cookie assinado,
# nunca HTTP Basic - ver painel/README.md). Gere a senha com: openssl rand -hex 16
FAROL_TECNICO_USER=farol_dpo
FAROL_TECNICO_PASSWORD=gere-com-openssl-rand--hex-16
# Credencial SEPARADA do painel gerencial (desde 2026-08-22) - público
# diferente do técnico (quem decide, não quem opera o motor), sessão própria
# (_exigir_login_gerencial) - uma credencial nunca abre a rota da outra.
FAROL_GERENCIAL_USER=farol_dpo_gerencial
FAROL_GERENCIAL_PASSWORD=gere-com-openssl-rand--hex-16
# Chave usada para assinar o cookie de sessão - sem ela, ninguém consegue
# logar. Gere com: openssl rand -hex 32. Trocar este valor invalida toda
# sessão ativa (força relogin geral) - normal na primeira vez, evite trocar
# depois sem motivo.
FAROL_SESSION_SECRET=gere-com-openssl-rand--hex-32

# URL pública de cada portal CKAN, usada só para montar o link "ver recurso
# original" no painel (nunca para autenticar nem baixar nada) - uma por
# ambiente (achado real de produção vs achado do CKAN de teste sintético).
FAROL_PORTAL_PRODUCAO=https://dados.example.gov.br
FAROL_PORTAL_SINTETICO=https://<ip-ou-host-do-ckan-de-teste>:8444

# URL interna do serviço `scanner`, usada pela tela /scan (disparar, cancelar
# e acompanhar scan pelo navegador, sem precisar de linha de comando) - o
# painel repassa a chamada pra la, injetando o usuario da sessao como
# executado_por. Default ja funciona em qualquer instalacao padrao do
# compose.
FAROL_SCANNER_URL=http://scanner:8000

# --- Plugin preventivo (ckanext-farol-guard) ---------------------------------
# Token de serviço que o plugin usa para registrar achado no painel via
# POST /v1/achados (não é a mesma credencial do login humano acima - ver
# ckanext-farol-guard/README.md). Gere com: openssl rand -hex 32
FAROL_INGEST_TOKEN=gere-com-openssl-rand--hex-32
FAROL_PII_ENGINE_URL=http://pii-engine:8000
FAROL_PAINEL_URL=http://painel:8080
# true = trata nao_analisado como bloqueio; false (padrão) é mais permissivo -
# recusar automaticamente algo que o motor nem chegou a avaliar é pior do
# que deixar publicar e revisar depois.
FAROL_BLOQUEIA_NAO_ANALISADO=false
FAROL_AMBIENTE=sintetico

# --- pii-engine: verificação de certificado TLS no download de recurso -----
# Padrão seguro: true. Só desligue globalmente (false) se souber exatamente
# por quê - qualquer download de portal de terceiro real (dados.gov.br,
# IBGE, CAPES etc.) precisa continuar verificando o certificado de verdade.
FAROL_VERIFY_TLS=true
# Lista separada por vírgula de hosts com certificado autoassinado conhecido
# (ex. o CKAN de teste local) - a única exceção aceitável, feita
# por host, nunca globalmente. Vazio por padrão (nenhuma exceção).
FAROL_HOSTS_TLS_INSEGURO=

# --- Camada 3 (classificador LLM local, llama.cpp + Qwen3) -----------------
MODEL_REPO=Qwen/Qwen3-4B-GGUF
MODEL_FILE=Qwen3-4B-Q4_K_M.gguf
LLM_MODEL=qwen3-4b
LLAMA_THREADS=4
FAROL_LLM_URL=http://llm:8080
